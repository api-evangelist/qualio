          "id": "ad4f8d22-80d3-45cc-bb96-0604d39ba258",
          "name": "Query the audit trail",
          "request": {
            "name": "Query the audit trail",
            "description": {
              "content": "Returns the company's audit trail: a chronological, immutable log of significant user and system activity across the quality management system (also referred to as the activity log or history). Each entry captures the action performed, the user who performed it (or none, for automated system actions), the date, and a link to the affected object. Tracked activity includes document approvals, reviews and status changes; user and group management (invitations, account changes, group membership); tag changes; quality event, issue and task activity; periodic reviews; and configuration changes such as SSO and billing. Results are scoped to the company associated with the API key and can be filtered by user and by date range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "audit-trail",
                "audits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<number>",
                  "description": "A start point for the batch to be returned. For example, a value of 5 will start at the 6th element in the overall population"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<number>",
                  "description": "(Required) The maximum number of results to return. This is typically used with offset to paginate results."
                },
                {
                  "disabled": false,
                  "key": "user_id",
                  "value": "<number>",
                  "description": "A unique identifier for a user in Qualio"
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<string>",
                  "description": "Filter results from this date onwards (ISO 8601 format)"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<string>",
                  "description": "Filter results up to this date (ISO 8601 format)"
                }
              ],
              "variable": []
            },
